SERVICE_IA_ENVIRONMENT=development
SERVICE_IA_DEBUG=false
SERVICE_IA_LOG_LEVEL=INFO
SERVICE_IA_DATABASE_URL=postgresql+asyncpg://service_ia:change-me@postgres:5432/service_ia
SERVICE_IA_CORS_ORIGINS=["http://localhost:3000"]
SERVICE_IA_REQUIRE_KORYXA_CONTEXT=true
SERVICE_IA_PROXY_SECRET=
SERVICE_IA_TRUSTED_PROXY_SOURCES='["koryxa-gateway","koryxa-admin","koryxa-services-ia"]'
SERVICE_IA_FILE_STORAGE_PATH=storage/files
SERVICE_IA_MAX_UPLOAD_BYTES=10485760
SERVICE_IA_KNOWLIA_BASE_URL=http://localhost:8093
SERVICE_IA_KNOWLIA_TIMEOUT_SECONDS=30
SERVICE_IA_KNOWLIA_SHARED_STORAGE_PATH=/shared/service-ia-files
