# Installer sous /opt/env/koryxa-services-ia-backend.env avec des droits 0640 root:deploy.
SERVICE_IA_ENVIRONMENT=production
SERVICE_IA_DEBUG=false
SERVICE_IA_LOG_LEVEL=INFO
SERVICE_IA_DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_MANAGED_POSTGRES_URL
SERVICE_IA_CORS_ORIGINS=["https://service-ia.koryxa.fr"]
SERVICE_IA_REQUIRE_KORYXA_CONTEXT=true
SERVICE_IA_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SERVICE_IA_TRUSTED_PROXY_SOURCES=["koryxa-gateway","koryxa-admin","koryxa-services-ia"]
SERVICE_IA_FILE_STORAGE_PATH=/app/storage/files
SERVICE_IA_MAX_UPLOAD_BYTES=10485760
SERVICE_IA_KNOWLIA_BASE_URL=http://prod_knowlia:8080
SERVICE_IA_KNOWLIA_TIMEOUT_SECONDS=30
SERVICE_IA_KNOWLIA_SHARED_STORAGE_PATH=/shared/service-ia-files
